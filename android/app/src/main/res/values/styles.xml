<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#0b1017</item>
        <item name="colorPrimaryDark">#0b1017</item>
        <item name="colorAccent">#22ff9e</item>
        <item name="android:windowBackground">#0b1017</item>
        <item name="android:statusBarColor">#0b1017</item>
        <item name="android:navigationBarColor">#0b1017</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#0b1017</item>
    </style>
</resources>
